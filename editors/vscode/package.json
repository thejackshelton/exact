{
  "name": "exact-contract",
  "displayName": "Exact Contract",
  "description": "Syntax highlighting for Exact Contract files, a problem matcher for the Contract compiler's diagnostics, `.contract` registered with TypeScript 7 for the content mapper, and formatting by the Contract compiler.",
  "version": "0.5.0",
  "private": true,
  "publisher": "exact",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:exact-contract"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "exact-contract",
        "aliases": [
          "Exact Contract",
          "Contract"
        ],
        "extensions": [
          ".contract"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "exact-contract",
        "scopeName": "source.exact-contract",
        "path": "./syntaxes/exact-contract.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Exact Contract",
      "properties": {
        "exactContract.compiler": {
          "type": "string",
          "scope": "machine-overridable",
          "markdownDescription": "The Contract compiler, `contract`, by its path. When set, **Format Document** on a `.contract` file runs `contract fmt --stdin` on the editor's text. Unset, no formatter is registered and nothing is run."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "exact-contract",
        "label": "Exact Contract compiler",
        "owner": "exact-contract",
        "source": "contract",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+) (?:(warning) )?\\[([a-z0-9-]+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ]
  },
  "files": [
    "README.md",
    "extension.js",
    "language-configuration.json",
    "syntaxes/*.json"
  ]
}
