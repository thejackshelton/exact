routes nav
  start "/"

component BootPlain
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column"
          list testId="list" appearance="auto" listStyle="plain" flex=1 min-height=0
            for i in [1, 2, 3] key=i
              section
                row
                  text `Row ${i}`
