routes nav
  tab barless "/"
    detail "/detail"
  tab other "/other"

component BootTabs
  action open
    nav = push(nav, "/detail")
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" testId="app" width="100%" height="100%"
      column position="relative" width="100%" height="100%"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationBar="none" testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
                scroll flex=1 min-height=0
                  button press=open testId="open"
                    text "Open"
                  column height=1600
      row role="tablist" appearance="none" position="absolute" bottom=0
        button role="tab" aria-controls="panel-barless" aria-selected=true
          text "Barless"
        button role="tab" aria-controls="panel-other" aria-selected=false
          text "Other"
