routes nav
  start "/"

component BootDialog
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
          text "Page"
      dialog id="launch-alert" role="alertdialog" aria-label="Launch alert"
        text "Message"
        button commandfor="launch-alert" command="close"
          text "OK"
