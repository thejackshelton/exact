routes nav
  start "/"

keyframes breathe
  from opacity=0.5
  to opacity=1

component BootMotion
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
          text "Moving" animation="breathe 1s linear infinite"
