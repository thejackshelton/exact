routes nav
  start "/"

component BootClipboard
  state taps = 0
  action tap
    taps = taps + 1
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column copy=tap cut=tap paste=tap navigationKey=`${e.id}` navigationBar="none" testId="route" position="absolute" inset=0 display="flex" flex-direction="column"
          row testId="controls" height=52 align-items="center"
            button press=tap
              text "Change"
          scroll testId="list" flex=1 min-height=0
            text "First row"
            column height=1600
