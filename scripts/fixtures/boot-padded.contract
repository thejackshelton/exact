routes nav
  start "/"

component BootPadded
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" testId="route" position="absolute" inset=0 display="flex" flex-direction="column" padding-top=24
          scroll testId="list" flex=1 min-height=0
            text "list top" testId="list-top"
            column height=1600
