routes nav
  start "/"

component BootTransform
  state reports = 0
  action geometry(bw: number, bh: number, pw: number, ph: number)
    reports = reports + 1
  action release(x: number, y: number, scale: number, vx: number, vy: number, vscale: number)
    reports = reports + 1
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
          text `${reports}` testId="reports"
          view width=200 height=200 position="relative" overflow="hidden" padding=0 border-width=0
            view id="photo" width="100%" height="100%" box-sizing="border-box" padding=0 border-width=0 margin=0 translate="0px 0px" scale=1
              view transformDragFor="photo" transformgeometry=geometry transformrelease=release touch-action="none" position="absolute" inset=0
